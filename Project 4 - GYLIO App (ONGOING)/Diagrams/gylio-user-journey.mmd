%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "primaryColor": "#f8fafc", "primaryBorderColor": "#334155", "primaryTextColor": "#0f172a", "lineColor": "#475569", "secondaryColor": "#eef2ff", "tertiaryColor": "#ecfdf5", "fontFamily": "Inter, Segoe UI, Arial"}}}%%
flowchart TB
  classDef phase fill:#0f172a,stroke:#0f172a,stroke-width:1.3px,color:#ffffff;
  classDef user fill:#eef2ff,stroke:#4f46e5,stroke-width:1.2px,color:#1e1b4b;
  classDef app fill:#ecfdf5,stroke:#047857,stroke-width:1.2px,color:#064e3b;

  Start["Morning starts"]

  Prepare["Prepare<br/>Set alarm<br/>Choose trait focus<br/>Load lesson or video content"]
  Wake["Wake<br/>Receive alarm or notification cue<br/>Open activation screen<br/>Watch activation video or reel"]
  Plan["Plan<br/>Review lesson dashboard<br/>Check calendar blocks<br/>Select priority tasks"]
  Execute["Execute<br/>Mark task progress<br/>Write journal notes<br/>Persist daily state locally"]

  Start --> Prepare --> Wake --> Plan --> Execute

  class Start phase;
  class Prepare,Wake,Plan user;
  class Execute app;
