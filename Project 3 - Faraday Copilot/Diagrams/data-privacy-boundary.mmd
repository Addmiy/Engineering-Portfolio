%%{init: {"theme": "base", "themeVariables": {"background": "#ffffff", "primaryColor": "#f8fafc", "primaryBorderColor": "#334155", "primaryTextColor": "#0f172a", "lineColor": "#475569", "secondaryColor": "#ecfdf5", "tertiaryColor": "#fee2e2", "fontFamily": "Inter, Segoe UI, Arial"}}}%%
flowchart LR
  classDef local fill:#ecfdf5,stroke:#047857,stroke-width:1.3px,color:#064e3b;
  classDef external fill:#fee2e2,stroke:#dc2626,stroke-width:1.3px,color:#7f1d1d;
  classDef user fill:#eef2ff,stroke:#4f46e5,stroke-width:1.3px,color:#1e1b4b;
  classDef control fill:#f8fafc,stroke:#334155,stroke-width:1.2px,color:#0f172a;

  subgraph UserContext["User-controlled context"]
    PageText["Visible page text and metadata"]
    Selection["Selected text"]
    DocsId["Google Docs document ID"]
  end

  subgraph Extension["Local extension boundary"]
    UI["Side panel and fullscreen app"]
    Settings["Settings and model choices"]
    ApiKey["OpenRouter API key in chrome.storage.local"]
    History["Chat history and citation notebook"]
    Files["Session files and page context"]
  end

  subgraph External["External services"]
    OpenRouter["OpenRouter chat-completions API"]
    AppsScript["User-deployed Apps Script companion"]
    Model["Selected AI model provider"]
  end

  PageText --> UI
  Selection --> UI
  DocsId --> AppsScript
  AppsScript --> Files

  UI --> Settings
  UI --> History
  UI --> Files
  Settings --> OpenRouter
  ApiKey --> OpenRouter
  History --> OpenRouter
  Files --> OpenRouter
  OpenRouter --> Model
  Model --> UI

  class PageText,Selection,DocsId user;
  class UI,Settings,ApiKey,History,Files local;
  class OpenRouter,AppsScript,Model external;
